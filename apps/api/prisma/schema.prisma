// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- ENUMS ----------

enum TransactionType {
  INCOME
  EXPENSE
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalType {
  SAVING
  SPENDING_LIMIT
}

enum WorkspaceType {
  PERSONAL
  BUSINESS
}

enum MemberRole {
  OWNER // dono: faz tudo, inclusive apagar o espaço
  ADMIN // gerencia membros e dados
  MEMBER // lança e edita dados
  VIEWER // só visualiza (ex.: contador)
}

// ---------- IDENTIDADE ----------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships         WorkspaceMember[]
  transactionsCreated Transaction[]

  @@map("users")
}

// ---------- ESPAÇOS ----------

model Workspace {
  id        String        @id @default(uuid())
  name      String
  type      WorkspaceType @default(PERSONAL)
  document  String? // CNPJ, quando for empresa
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  members      WorkspaceMember[]
  categories   Category[]
  transactions Transaction[]
  recurrings   RecurringTransaction[]
  goals        Goal[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String     @id @default(uuid())
  workspaceId String     @map("workspace_id")
  userId      String     @map("user_id")
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ---------- DADOS FINANCEIROS ----------

model Category {
  id          String          @id @default(uuid())
  name        String
  type        TransactionType
  color       String?
  icon        String?
  workspaceId String?         @map("workspace_id") // null = categoria padrão do sistema
  createdAt   DateTime        @default(now()) @map("created_at")

  workspace    Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurrings   RecurringTransaction[]
  goals        Goal[]

  @@unique([workspaceId, name, type])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid())
  description String
  amount      Int // centavos, sempre positivo
  type        TransactionType
  date        DateTime        @db.Date
  workspaceId String          @map("workspace_id")
  categoryId  String          @map("category_id")
  createdById String?         @map("created_by_id")
  recurringId String?         @map("recurring_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category              @relation(fields: [categoryId], references: [id])
  createdBy User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recurring RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([recurringId, date])
  @@index([workspaceId, date])
  @@map("transactions")
}

model RecurringTransaction {
  id          String          @id @default(uuid())
  description String
  amount      Int
  type        TransactionType
  frequency   Frequency
  startDate   DateTime        @map("start_date") @db.Date
  endDate     DateTime?       @map("end_date") @db.Date
  nextRunDate DateTime        @map("next_run_date") @db.Date
  active      Boolean         @default(true)
  workspaceId String          @map("workspace_id")
  categoryId  String          @map("category_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@map("recurring_transactions")
}

model Goal {
  id            String    @id @default(uuid())
  name          String
  type          GoalType
  targetAmount  Int       @map("target_amount")
  currentAmount Int       @default(0) @map("current_amount")
  deadline      DateTime? @db.Date
  categoryId    String?   @map("category_id")
  workspaceId   String    @map("workspace_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])

  @@map("goals")
}
